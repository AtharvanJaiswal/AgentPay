# AgentPay Environment Configuration Template
# IMPORTANT: Copy this file to .env for local development. Never commit real credentials to version control.

# Node & Runtime Environment
NODE_ENV=development
LOG_LEVEL=info

# Service Ports (Local development)
WEB_PORT=3000
API_GATEWAY_PORT=4000
AGENT_SERVICE_PORT=4001
POLICY_SERVICE_PORT=4002
PAYMENT_SERVICE_PORT=4003
AUDIT_SERVICE_PORT=4004

# Service URLs (for API Gateway and inter-service routing)
# Note: In Docker Compose, service DNS names (e.g. http://agent-service:4001) are used automatically.
API_GATEWAY_URL=http://localhost:4000
AGENT_SERVICE_URL=http://localhost:4001
POLICY_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4003
AUDIT_SERVICE_URL=http://localhost:4004
APP_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Local development default credentials - do not use in production
DATABASE_URL=postgresql://agentpay:agentpay_dev_pw@localhost:5432/agentpay
POSTGRES_USER=agentpay
POSTGRES_PASSWORD=agentpay_dev_pw
POSTGRES_DB=agentpay
POSTGRES_PORT=5432

# Payment Provider Configuration
# Set to 'mock' for development/testing.
# Real PayPal Sandbox adapter will be configured in a subsequent phase.
PAYMENT_PROVIDER=mock
PAYMENTS_ENABLED=false

# PayPal Sandbox Configuration (Empty placeholders only - DO NOT COMMIT SECRETS)
# To test PayPal Sandbox OAuth, Orders v2, and Captures, populate these in your local uncommitted .env file:
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=
# PAYMENT_PROVIDER=mock (switch to paypal_sandbox to activate the PayPal Orders v2 adapter)
# PAYMENTS_ENABLED=false (switch to true only when explicitly testing payment capture operations)
