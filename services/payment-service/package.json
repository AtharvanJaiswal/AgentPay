{
  "name": "@agentpay/payment-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "verify:paypal": "tsx src/cli/verify-paypal.ts",
    "test:paypal-order": "tsx src/cli/test-sandbox-order.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentpay/config": "workspace:*",
    "@agentpay/contracts": "workspace:*",
    "@agentpay/logger": "workspace:*",
    "@fastify/cors": "10.0.2",
    "fastify": "5.2.1",
    "pg": "8.13.1",
    "uuid": "11.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@agentpay/test-utils": "workspace:*",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.11",
    "@types/uuid": "10.0.0",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
